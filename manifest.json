{
  "manifest_version": 3,
  "name": "Kiosk Exit Button: Close Chrome Kiosk Mode Without a Keyboard",
  "version": "1.0.0",
  "description": "Add an on-screen close button to Chrome kiosk mode. Exit with one click, no keyboard shortcuts needed. Customizable, auto-hides.",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "system.display"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["images/default.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
